# Copia a .env en el VPS (cp .env.vps.example .env) y rellena los valores. .env NO se sube a GitHub.

# IDs de tu usuario en el VPS:  id -u   e   id -g
APP_UID=1000
APP_GID=1000

# Base de datos. La clave va dentro de una URL: usa solo letras y numeros (openssl rand -hex 16)
POSTGRES_USER=naval
POSTGRES_PASSWORD=GENERA_CON_openssl_rand_-hex_16
POSTGRES_DB=naval

# Firma las sesiones (minimo 16 caracteres):  openssl rand -hex 32
JWT_SECRET=GENERA_CON_openssl_rand_-hex_32

# Opcionales (ya tienen valor por defecto en el compose)
AI_WORKERS=1
MC_SAMPLES=20000
GUEST_AI_DAILY=10
AUTH_PER_MINUTE=60
QUIZ_PER_MINUTE=120
