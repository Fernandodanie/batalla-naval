# Copia este archivo a .env  (o ejecuta:  node scripts/init-env.mjs  y se crea con secretos aleatorios)

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=naval
POSTGRES_PASSWORD=cambia-esto-por-una-clave
POSTGRES_DB=naval

# --- Backend ---
# Firma los tokens de sesión. Mínimo 16 caracteres; el backend NO arranca en producción con el valor de ejemplo.
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
# Hilos para calcular la IA en paralelo. Vacío = automático (0 si el equipo tiene 1 núcleo, hasta 2 si tiene más).
AI_WORKERS=
# IA Experta (Monte Carlo): muestras por jugada y cómo se comunican los hilos (shared = memoria compartida, message = postMessage).
MC_SAMPLES=20000
MC_MODE=shared
# Desde qué costo (muestras × barcos) conviene repartir una decisión entre hilos. Calíbralo en tu equipo: npm run calibrate
PARALLEL_MIN_COST=100000
# IA distribuida (opcional): nodos de cálculo remotos y el secreto que comparten con el backend. Ver docker-compose.yml.
AI_NODES=
AI_NODE_TOKEN=cambia-esto-por-un-secreto-para-los-nodos
# Partidas diarias contra la IA para invitados (sin cuenta), por IP. 0 = sin límite. Las salas con amigos y las cuentas no cuentan.
GUEST_AI_DAILY=10
# Límites por IP y minuto. En un colegio muchas personas comparten IP: si un curso entra a la vez, sube estos valores.
AUTH_PER_MINUTE=20
QUIZ_PER_MINUTE=60
TURN_SECONDS=30
PLACEMENT_SECONDS=90

# --- Web ---
WEB_PORT=8080
